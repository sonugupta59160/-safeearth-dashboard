APP_ENV=development
PORT=5000
LOG_LEVEL=INFO

# Origins allowed to call this API directly (comma-separated). Not needed in local dev because the
# Vite proxy makes requests same-origin, but required when the frontend is deployed elsewhere.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Identifies you to OpenStreetMap services (Nominatim/Overpass require this). Use a real contact.
APP_USER_AGENT=SafeEarthAI/1.0 (contact: your-email@example.com)

# Gemini assistant. Keys live ONLY here, never in the frontend.
# Get a key at https://aistudio.google.com and set LLM_MODEL to a current Gemini model name from Google's docs.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=

# NASA FIRMS wildfire hotspots (free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
